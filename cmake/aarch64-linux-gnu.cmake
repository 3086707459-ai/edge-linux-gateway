set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(DEFINED ENV{CROSS_COMPILE})
  set(EDGE_CROSS_PREFIX "$ENV{CROSS_COMPILE}")
else()
  set(EDGE_CROSS_PREFIX "aarch64-linux-gnu-")
endif()
set(CMAKE_CXX_COMPILER "${EDGE_CROSS_PREFIX}g++")
if(NOT DEFINED ENV{EDGE_SYSROOT})
  message(FATAL_ERROR "Set EDGE_SYSROOT to the target SDK sysroot containing ARM SQLite headers and libraries")
endif()
set(CMAKE_SYSROOT "$ENV{EDGE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
